# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.
# These are NAMES ONLY -- never put real values in this file.

# --- Database (Neon) ---
# Neon dashboard > your project > Connection string (pooled, requires SSL).
DATABASE_URL=

# --- Auth (added in roadmap step 12; placeholder so the name is agreed now) ---
# Long random string used to sign the session cookie.
SESSION_SECRET=

# --- Stripe, TEST MODE ONLY (added in roadmap steps 18-19) ---
# The only key that may be exposed to the browser.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Server-only. Never log this, never prefix it with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the Vercel webhook endpoint in the dashboard.
STRIPE_WEBHOOK_SECRET=

# --- Deployment ---
# Public base URL of the app. http://localhost:3000 locally.
NEXT_PUBLIC_APP_URL=
